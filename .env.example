NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Clave que autoriza la sincronización (POST /api/sync). La usuaria la ingresa
# una vez en la app y debe coincidir con este valor (solo en el servidor).
SYNC_SECRET=define_una_clave_larga_y_aleatoria

# Clave administrativa para sembrar catálogos (POST /api/seed con header x-seed-secret).
SEED_SECRET=define_otra_clave_distinta
